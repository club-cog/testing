CREATE OR REPLACE PACKAGE BODY pkg_billing AS

    g_run_label VARCHAR2(40) := 'UNSET';

    PROCEDURE write_billing_log (
        p_entity_id   IN audit_log.entity_id%TYPE,
        p_action_code IN audit_log.action_code%TYPE,
        p_payload     IN VARCHAR2
    ) IS
        PRAGMA AUTONOMOUS_TRANSACTION;
    BEGIN
        INSERT INTO audit_log (
            audit_id,
            event_time,
            entity_name,
            entity_id,
            action_code,
            actor_name,
            payload
        )
        VALUES (
            seq_audit_log.NEXTVAL,
            SYSDATE,
            'INVOICE',
            p_entity_id,
            p_action_code,
            NVL(SYS_CONTEXT('USERENV', 'SESSION_USER'), 'BATCH'),
            p_payload
        );
        COMMIT;
    EXCEPTION
        WHEN OTHERS THEN
            ROLLBACK;
            NULL;
    END write_billing_log;

    PROCEDURE issue_invoice (
        p_order_id   IN orders.order_id%TYPE,
        p_invoice_id OUT invoices.invoice_id%TYPE
    ) IS
        l_order_total invoices.invoice_total%TYPE;
        l_invoice_no  invoices.invoice_number%TYPE;
        l_note        CLOB;
        l_note_text   VARCHAR2(200) := 'Generated by legacy billing batch';
    BEGIN
        SELECT NVL(total_amount, 0)
        INTO l_order_total
        FROM orders
        WHERE order_id = p_order_id;

        SELECT 'INV-' || TO_CHAR(seq_invoices.NEXTVAL)
        INTO l_invoice_no
        FROM DUAL;

        DBMS_LOB.CREATETEMPORARY(l_note, TRUE);
        DBMS_LOB.WRITEAPPEND(l_note, LENGTH(l_note_text), l_note_text);

        INSERT INTO invoices (
            invoice_id,
            invoice_number,
            order_id,
            issued_on,
            due_on,
            invoice_status,
            invoice_total,
            tax_total,
            delivery_note
        )
        VALUES (
            seq_invoices.CURRVAL,
            l_invoice_no,
            p_order_id,
            SYSDATE,
            SYSDATE + 30,
            'ISSUED',
            l_order_total,
            NVL(l_order_total, 0) * 0.0825,
            l_note
        )
        RETURNING invoice_id INTO p_invoice_id;

        g_run_label := 'INV-' || p_invoice_id;
        write_billing_log(p_invoice_id, 'ISSUED', g_run_label);

        IF DBMS_LOB.ISTEMPORARY(l_note) = 1 THEN
            DBMS_LOB.FREETEMPORARY(l_note);
        END IF;
    EXCEPTION
        WHEN OTHERS THEN
            IF DBMS_LOB.ISTEMPORARY(l_note) = 1 THEN
                DBMS_LOB.FREETEMPORARY(l_note);
            END IF;
            RAISE_APPLICATION_ERROR(-20911, 'Invoice creation failed: ' || SQLERRM);
    END issue_invoice;

    PROCEDURE apply_payment (
        p_invoice_id IN payments.invoice_id%TYPE,
        p_amount     IN payments.amount_paid%TYPE,
        p_method     IN payments.payment_method%TYPE
    ) IS
        l_invoice_total invoices.invoice_total%TYPE;
        l_paid_total    payments.amount_paid%TYPE;
        l_status        invoices.invoice_status%TYPE;
    BEGIN
        SELECT invoice_total, invoice_status
        INTO l_invoice_total, l_status
        FROM invoices
        WHERE invoice_id = p_invoice_id
        FOR UPDATE;

        SELECT NVL(SUM(amount_paid), 0)
        INTO l_paid_total
        FROM payments
        WHERE invoice_id = p_invoice_id
          AND payment_status = 'CAPTURED';

        INSERT INTO payments (
            payment_id,
            invoice_id,
            paid_on,
            payment_method,
            payment_status,
            amount_paid
        )
        VALUES (
            seq_payments.NEXTVAL,
            p_invoice_id,
            SYSDATE,
            NVL(p_method, 'UNKNOWN'),
            DECODE(l_status, 'VOID', 'PENDING', 'CAPTURED'),
            p_amount
        );

        l_paid_total := NVL(l_paid_total, 0) + NVL(p_amount, 0);
        UPDATE invoices
        SET invoice_status = CASE
                                 WHEN l_paid_total >= NVL(l_invoice_total, 0)
                                 THEN 'PAID'
                                 ELSE 'PARTIAL'
                             END
        WHERE invoice_id = p_invoice_id;

        write_billing_log(
            p_invoice_id,
            'PAYMENT',
            'paid=' || TO_CHAR(p_amount) || ';method=' || NVL(p_method, 'UNKNOWN')
        );
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE_APPLICATION_ERROR(-20912, 'Invoice does not exist');
        WHEN OTHERS THEN
            RAISE;
    END apply_payment;

    PROCEDURE rebuild_invoice_totals (
        p_invoice_id IN invoices.invoice_id%TYPE
    ) IS
        TYPE t_line_id_list IS TABLE OF invoice_lines.invoice_line_id%TYPE;
        TYPE t_amount_list IS TABLE OF invoice_lines.line_amount%TYPE;
        l_line_ids t_line_id_list;
        l_amounts  t_amount_list;
        l_total    invoices.invoice_total%TYPE;
        l_sql      VARCHAR2(4000);
    BEGIN
        l_sql := 'SELECT invoice_line_id, NVL(line_amount, 0) '
              || 'FROM invoice_lines WHERE invoice_id = :1';
        EXECUTE IMMEDIATE l_sql BULK COLLECT INTO l_line_ids, l_amounts
            USING p_invoice_id;

        l_total := 0;
        FOR i IN 1..l_amounts.COUNT LOOP
            l_total := l_total + NVL(l_amounts(i), 0);
        END LOOP;

        FORALL i IN 1..l_line_ids.COUNT
            UPDATE invoice_lines
            SET tax_amount = ROUND(NVL(l_amounts(i), 0) * 0.0825, 2)
            WHERE invoice_line_id = l_line_ids(i);

        UPDATE invoices
        SET invoice_total = l_total,
            tax_total = ROUND(l_total * 0.0825, 2)
        WHERE invoice_id = p_invoice_id;

        DBMS_OUTPUT.PUT_LINE(
            'rebuilt ' || g_run_label || ' total=' || TO_CHAR(l_total)
        );
    END rebuild_invoice_totals;

END pkg_billing;
/
